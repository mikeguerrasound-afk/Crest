{
  "name": "crest",
  "productName": "Crest",
  "version": "2.0.0",
  "description": "A minimal audio and video player with a waveform you can select and drag straight into your DAW.",
  "main": "main.js",
  "author": "Crest",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test.js && node tests/test-features.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "e2e": "xvfb-run -a node tests/e2e.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.crest.player",
    "productName": "Crest",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
        "to": "licenses/ffmpeg.LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.README",
        "to": "licenses/ffmpeg.README"
      }
    ],
    "artifactName": "Crest-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "wave",
          "aif",
          "aiff",
          "flac",
          "mp3",
          "ogg",
          "oga",
          "opus",
          "m4a",
          "aac",
          "wma",
          "ac3",
          "caf",
          "mp4",
          "m4v",
          "mov",
          "webm",
          "mkv",
          "avi",
          "mpg",
          "mpeg",
          "wmv",
          "mxf",
          "ogv"
        ],
        "name": "Audio/Video file",
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}